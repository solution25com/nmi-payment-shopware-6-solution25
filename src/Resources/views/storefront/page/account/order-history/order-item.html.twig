{% sw_extends '@Storefront/storefront/page/account/order-history/order-item.html.twig' %}

{% block page_account_order_item_order_table_body_cell_payment_status %}
    {% set net30 = order.extensions.dealerNet30 ?? null %}
    <div class="col-12 col-sm order-table-header-order-table-body-cell">
        <strong class="order-table-header-label">
            {{ 'account.orderPaymentStatus'|trans|sw_sanitize }}{{ 'account.colonCharacter'|trans|sw_sanitize }}
        </strong>
        {% if feature('v6.8.0.0') %}
            <span class="order-table-body-value">
                {{ order.primaryOrderTransaction.stateMachineState.translated.name }}
                {% if net30 is not null and net30.dueDate %}
                    <br />
                    <span class="text-muted">
                        Due date:
                        <strong>{{ net30.dueDate|date('M d y, h:i A', null, app.request.locale) }}</strong>
                        {% if net30.isOverdue %}
                            (Overdue)
                        {% endif %}
                    </span>
                    {% if net30.alternateDueDate %}
                        <br />
                        <span class="text-muted">
                            Alternate due date:
                            <strong>{{ net30.alternateDueDate|date('M d y, h:i A', null, app.request.locale) }}</strong>
                        </span>
                    {% endif %}
                {% endif %}
            </span>
        {% else %}
            <span class="order-table-body-value">
                {{ order.transactions|last.stateMachineState.translated.name }}
                {% if net30 is not null and net30.dueDate %}
                    <br />
                    <span class="text-muted">
                        Due date:
                        <strong>{{ net30.dueDate|date('M d Y, h:i A', null, app.request.locale) }}</strong>
                        {% if net30.isOverdue %}
                            (Overdue)
                        {% endif %}
                    </span>
                    {% if net30.alternateDueDate %}
                        <br />
                        <span class="text-muted">
                            Alternate due date:
                            <strong>{{ net30.alternateDueDate|date('M d Y, h:i A', null, app.request.locale) }}</strong>
                        </span>
                    {% endif %}
                {% endif %}
            </span>
        {% endif %}
    </div>
{% endblock %}


