{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {{ parent() }}
    {#
        STYLES MIGRATED ─────────────────────────────────────────────────────────
        All CSS originally defined in this block's <style> tag has been moved to:
          Resources/app/storefront/src/scss/net-thirty/_bulk-payment.scss
        Compiled via base.scss → storefront bundle.
        The original inline <style> block is preserved below, commented out,
        for migration traceability.

    <style>
        .bulk-pay-hero-STUB { ... }
        .bulk-card { ... }
        ... (full content preserved in _bulk-payment.scss)
    </style>
    #}
{% endblock %}

{% block base_main %}
    <div class="container py-4">
        <div class="bulk-pay-hero">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="h3 mb-1">Pay Multiple Orders</h1>
                    <p class="mb-0">Select a saved card to pay all selected orders.</p>
                </div>
                <div class="badge badge-pill payment-pill">
                    Total: {{ totalAmount|currency(orders|first.currency.isoCode) }}
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12">
                <div class="card bulk-card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Orders to Pay</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm bulk-summary-table mb-0">
                            <thead>
                                <tr>
                                    <th>Order Number</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in orders %}
                                    <tr>
                                        <td class="fw-semibold">{{ order.orderNumber }}</td>
                                        <td>{{ order.orderDateTime|date('M d, Y') }}</td>
                                        <td class="text-end fw-semibold">{{ order.price.totalPrice|currency(order.currency.isoCode) }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="table-active">
                                    <td colspan="2" class="fw-bold">Total</td>
                                    <td class="text-end fw-bold">{{ totalAmount|currency(orders|first.currency.isoCode) }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12">
                {#
                    JS PLUGIN ROOT ─────────────────────────────────────────────────────────
                    NetThirtyBulkPaymentPlugin is registered on this <form> element.
                    All Twig-generated values needed by the plugin are passed as data-*
                    attributes so the compiled JS file remains free of inline Twig.
                    Plugin file: net-thirty-plugin/net-thirty-bulk-payment.plugin.js
                    Registered in: main.js as NetThirtyBulkPaymentPlugin
                #}
                <form id="bulkPaymentForm"
                      class="bulk-payment-form"
                      method="post"
                      action="javascript:void(0);"
                      onsubmit="return false;"
                      data-net-thirty-bulk-payment-plugin
                      data-has-saved-cards="{{ (savedCards and savedCards|length > 0) ? '1' : '0' }}"
                      data-order-ids="{{ orderIds|json_encode }}"
                      data-enable-credit-card="{{ enableCreditCardPayment ? '1' : '0' }}"
                      data-public-key="{{ nmiConfigs.publicKey }}"
                      data-total-amount="{{ totalAmount }}"
                      data-url-process-nmi="{{ path('frontend.account.invoices.bulk-payment.process-nmi') }}"
                      data-url-process-ach="{{ path('frontend.account.invoices.bulk-payment.process-ach') }}"
                      data-url-process-nmi-token="{{ path('frontend.account.invoices.bulk-payment.process-nmi-token') }}"
                      data-url-invoices="{{ path('frontend.account.invoices.page') }}">

                    <div class="card bulk-card">
                        <div class="card-header">
                            <h5 class="mb-0">Select Payment Method</h5>
                        </div>
                        <div class="card-body">
                            {% if enableCreditCardPayment %}
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Choose Payment Type:</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="paymentType" id="paymentTypeCreditCard" value="credit_card" checked>
                                        <label class="form-check-label" for="paymentTypeCreditCard">
                                            Credit Card
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="paymentType" id="paymentTypeACH" value="ach">
                                        <label class="form-check-label" for="paymentTypeACH">
                                            ACH / eCheck
                                        </label>
                                    </div>
                                </div>
                            </div>
                            {% else %}
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Payment Type:</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        {# Radio hidden visually; plugin reads its value — style moved to .nmi-radio-hidden in _bulk-payment.scss #}
                                        <input class="form-check-input nmi-radio-hidden" type="radio" name="paymentType" id="paymentTypeACH" value="ach" checked>
                                        <label class="form-check-label" for="paymentTypeACH">
                                            ACH / eCheck
                                        </label>
                                    </div>
                                </div>
                            </div>
                            {% endif %}

                            {% if enableCreditCardPayment %}
                            <div id="creditCardSection" class="payment-method-section">
                                {% if savedCards and savedCards|length > 0 %}
                                    {% set cardImages = {
                                        'AMEX':         'https://files.readme.io/97e7acc-Amex.png',
                                        'DINERS':        'https://files.readme.io/8c73810-Diners_Club.png',
                                        'DISCOVER':      'https://files.readme.io/caea86d-Discover.png',
                                        'JCB':           'https://files.readme.io/e076aed-JCB.png',
                                        'MASTERCARD':    'https://files.readme.io/5b7b3de-Mastercard.png',
                                        'VISA':          'https://files.readme.io/9018c4f-Visa.png',
                                        'MAESTRO':       'data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 50 32%27%3E%3Ccircle cx=%2718%27 cy=%2716%27 r=%2213%27 fill=%27%23EB001B%27/%3E%3Ccircle cx=%2732%27 cy=%2716%27 r=%2213%27 fill=%27%2300A2E5%27/%3E%3Cpath d=%27M25 5.2a13 13 0 0 1 0 21.6 13 13 0 0 1 0-21.6z%27 fill=%27%237673C0%27/%3E%3C/svg%3E',
                                        'UNIONPAY':      'https://files.readme.io/92c35c7-UnionPay.png',
                                        'ELECTRON':      'https://files.readme.io/def3490-Electron.png',
                                        'DANKORT':       'https://files.readme.io/ff5319d-Dankort.png',
                                        'INTERPAYMENT':  'https://files.readme.io/cf79c1b-Interpayment.png',
                                        'CUP':           'https://files.readme.io/92c35c7-UnionPay.png'
                                    } %}
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold mb-2">Select a card to pay:</label>
                                        <div class="cards-container">
                                            {% for card in savedCards %}
                                                <div class="credit-card {{ card.cardType|lower }}{% if card.isDefault %} is-default{% endif %}"
                                                     data-card-id="{{ card.billingId }}"
                                                     data-vault-id="{{ card.vaultedCustomerId }}">
                                                    {# Radio hidden; card tile click handled by plugin — style .nmi-radio-hidden in _bulk-payment.scss #}
                                                    <input type="radio" name="paymentMethod" value="saved"
                                                           id="card-{{ card.billingId }}"
                                                           data-vault-id="{{ card.vaultedCustomerId }}"
                                                           data-billing-id="{{ card.billingId }}"
                                                           class="nmi-radio-hidden">
                                                    <div class="card-selected-mark d-none">✓</div>
                                                    <div class="card-header">
                                                        <span class="card-type">
                                                            {% if attribute(cardImages, card.cardType|upper) is defined %}
                                                                <img src="{{ attribute(cardImages, card.cardType|upper) }}" alt="{{ card.cardType }}" class="card-icon">
                                                            {% endif %}
                                                            {{ card.cardType }}
                                                        </span>
                                                        {% if card.isDefault %}
                                                            <span class="default-badge">Default</span>
                                                        {% endif %}
                                                    </div>
                                                    <div class="card-number">•••• •••• •••• {{ card.lastDigits|slice(-4) }}</div>
                                                    <div class="card-details">
                                                        <span>{{ card.firstName }} {{ card.lastName }}</span>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        <div class="mt-1">
                                            <small class="text-muted">
                                                Need to add, remove, or update a card?
                                                <a href="{{ path('frontend.account.nmi-saved-cards.page') }}" class="fw-semibold">Manage saved cards →</a>
                                            </small>
                                        </div>
                                    </div>
                                {% else %}
                                    {# No saved cards: form is shown immediately — no click-to-reveal step #}
                                    <div class="alert alert-info mb-3">
                                        <strong>No saved cards found.</strong><br>
                                        <small>Enter your card details below. Your card will be saved and all selected orders paid in one step.</small>
                                    </div>

                                    <div id="cc-card-entry">
                                        <div class="border rounded p-3 bg-light mb-3">
                                            <div class="row mb-3" id="cc-name-fields">
                                                <div class="col-md-6 mb-2 mb-md-0">
                                                    <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                                                    <input type="text" id="cc-first-name" class="form-control" value="{{ context.customer.firstName }}" placeholder="First Name">
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                                                    <input type="text" id="cc-last-name" class="form-control" value="{{ context.customer.lastName }}" placeholder="Last Name">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="alert alert-danger d-none mt-2" id="cc-new-card-error" role="alert"></div>
                                {% endif %}
                            </div>
                            {% else %}
                            <div id="creditCardSection" class="payment-method-section" style="display: none;"></div>
                            {% endif %}

                            <div id="achSection" class="payment-method-section" {% if enableCreditCardPayment %}style="display: none;"{% endif %}>
                                <div id="nmi-ach-echeck-bulk"
                                     data-nmi-ach-echeck="true"
                                     data-amount="{{ totalAmount }}"
                                     data-configs="{{ nmiConfigs|json_encode }}"
                                >
                                    <div class="d-none" id="nmi-customer-data-bulk">
                                        <input type="text" name="fname" value="{{ context.customer.firstName }}">
                                        <input type="text" name="lname" value="{{ context.customer.lastName }}">
                                        <input type="text" name="address1" value="{{ context.customer.defaultBillingAddress.street }}">
                                        <input type="text" name="city" value="{{ context.customer.defaultBillingAddress.city }}">
                                        <input type="text" name="state" value="{{ context.customer.defaultBillingAddress.countryState ? context.customer.defaultBillingAddress.countryState.shortCode : context.customer.defaultBillingAddress.country.name }}">
                                        <input type="text" name="zip" value="{{ context.customer.defaultBillingAddress.zipcode }}">
                                    </div>

                                    <div class="alert alert-info mb-3">
                                        <strong><i class="fas fa-info-circle"></i> ACH / eCheck Payment</strong><br>
                                        <small>Your payment will be processed securely via ACH/eCheck.</small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Bank Account Information <span class="text-danger">*</span></label>
                                        <div id="ach-payment-form-container" class="border rounded p-3 bg-light">
                                            <div class="text-center text-muted py-4">
                                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                                Loading payment form...
                                            </div>
                                        </div>
                                    </div>
                                    <div class="alert alert-danger d-none mt-3" id="ach-error-message" role="alert">
                                        <div class="error-alert">
                                            <p></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="loaderWrapper" style="display: none;">
                                <div class="loader bulk-payment-loader"></div>
                            </div>

                            <div class="d-flex justify-content-end mt-4 gap-2">
                                <a href="{{ path('frontend.account.invoices.page') }}" class="btn btn-secondary">Cancel</a>
                                {% if enableCreditCardPayment %}
                                <button type="button" id="payButton" class="btn btn-primary" style="display: none;">
                                    Pay {{ totalAmount|currency(orders|first.currency.isoCode) }}
                                </button>
                                {% if not (savedCards and savedCards|length > 0) %}
                                <button type="button" id="newCardPayButton" class="btn btn-primary" style="display: none;"
                                        data-label-enter="Add Card &amp; Pay"
                                        data-label-confirm="Confirm &amp; Pay {{ totalAmount|currency(orders|first.currency.isoCode) }}">
                                    Add Card &amp; Pay
                                </button>
                                {% endif %}
                                {% else %}
                                <button type="button" id="payButton" class="btn btn-primary" style="display: none !important;">
                                    Pay {{ totalAmount|currency(orders|first.currency.isoCode) }}
                                </button>
                                {% endif %}
                                <button type="button" id="achPayButton" class="btn btn-primary" style="display: {% if enableCreditCardPayment %}none{% else %}inline-block{% endif %};">
                                    Pay {{ totalAmount|currency(orders|first.currency.isoCode) }}
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {#
        SCRIPT MIGRATED ─────────────────────────────────────────────────────────
        All JavaScript originally in this block's <script> tag has been moved to:
          Resources/app/storefront/src/net-thirty-plugin/net-thirty-bulk-payment.plugin.js
        Registered in main.js as NetThirtyBulkPaymentPlugin on [data-net-thirty-bulk-payment-plugin].
        Twig-rendered values (orderIds, publicKey, URLs, flags) that were embedded
        directly in the script are now passed as data-* attributes on the <form>.
        The original inline <script> block is preserved below, commented out,
        for migration traceability.

    <script>
        const HAS_SAVED_CARDS = {{ (savedCards and savedCards|length > 0) ? 'true' : 'false' }};
        // ... full ~630 lines of logic preserved in net-thirty-bulk-payment.plugin.js
    </script>
    #}
{% endblock %}
