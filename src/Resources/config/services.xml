<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="NMIPayment\Service\NMIPaymentApiClient">
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <!-- Controller -->
         <service id="NMIPayment\Controller\NMISavedCardsController">
            <tag name="controller.service_arguments"/>
             <argument type="service" id="nmi_vaulted_customer.repository"/>
             <argument type="service" id="NMIPayment\Service\NMIVaultedCustomerService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
             <argument type="service" id="NMIPayment\Service\NMIConfigService" />
         </service>

        <service id="NMIPayment\Storefront\Controller\TestApiConnectionController" public="true">
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="router"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="NMIPayment\Storefront\Controller\NMIPaymentController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <argument type="service" id="NMIPayment\Validations\PaymentValidation"/>
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentDataRequestService" />
            <argument type="service" id="NMIPayment\Service\NMIVaultedCustomerService" />
            <argument type="service" id="NMIPayment\Service\NMIACHPaymentDataRequestService" />
            <argument type="service" id="NMIPayment.logger"/>
            <argument type="service" id="NMIPayment\Validations\VaultOwnershipGuard"/>
            <argument type="service" id="NMIPayment\Service\CardVelocityService"/>
        </service>

        <service id="NMIPayment\Storefront\Controller\NMIWebhookController" public="true">
            <argument type="service" id="NMIPayment\Service\NMIWebhookService"/>
            <argument type="service" id="NMIPayment.logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- End Controller -->

        <service id="NMIPayment\Gateways\AchEcheck">
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="NMIPayment\Service\NmiTransactionService"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="shopware.payment.method"/>
        </service>


        <!-- Gateways -->
        <service id="NMIPayment\Gateways\CreditCard">
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="NMIPayment\Service\NmiTransactionService"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentDataRequestService"/>
            <tag name="shopware.payment.method"/>
        </service>

        <service id="NMIPayment\Gateways\Net30">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyPaymentLinkService"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyOrderLifecycleService"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyPaymentOrchestrator"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyCustomerEligibilityService"/>
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="shopware.payment.method"/>
        </service>

        <!-- End Gateways -->

        <!-- Entity Definitions -->

        <service id="NMIPayment\Core\Content\Transaction\NmiTransactionDefinition">
            <tag name="shopware.entity.definition" entity="nmi_transaction"/>
        </service>

        <service id="NMIPayment\Core\Content\VaultedCustomer\VaultedCustomerDefinition">
            <tag name="shopware.entity.definition" entity="nmi_vaulted_customer"/>
        </service>

        <service id="NMIPayment\Core\Content\CardVelocity\CardVelocityDefinition">
            <tag name="shopware.entity.definition" entity="nmi_card_velocity"/>
        </service>

        <!--     End Entity Definitions -->

        <!--         Event Subscribers-->
        <service id="NMIPayment\EventSubscriber\CheckoutConfirmEventSubscriber">
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="NMIPayment\Service\NetThirtyCustomerEligibilityService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="NMIPayment\EventSubscriber\OrderVoidNmiPayment">
            <argument type="service" id="NMIPayment\Service\NmiTransactionService"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository" />
            <argument type="service" id="partial_delivery.repository" on-invalid="null" />
            <argument type="service" id="order_delivery.repository" />
            <argument type="service" id="NMIPayment.logger"/>
            <argument type="service" id="NMIPayment\Service\NmiCaptureService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="NMIPayment\EventSubscriber\RefundEventSubscriber">
            <argument type="service" id="NMIPayment\Service\NmiTransactionService"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="order_return.repository" on-invalid="null"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="NMIPayment\EventSubscriber\NetThirty\NetThirtyOrderTransactionSubscriber">
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyPaymentLinkService"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyOrderLifecycleService"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyPaymentOrchestrator"/>
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="NMIPayment\EventSubscriber\NetThirty\NetThirtyInvoiceGenerationSubscriber">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Document\Service\DocumentGenerator"/>
            <argument type="service" id="NMIPayment\Service\DealerConfigService"/>
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="NMIPayment\EventSubscriber\NetThirty\AccountOrderPageSubscriber">
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="NMIPayment\EventSubscriber\NetThirty\AccountInvoicesPageSubscriber">
            <argument type="service" id="NMIPayment.logger"/>
            <argument type="service" id="NMIPayment\Service\DealerDocumentCriteriaService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="NMIPayment\EventSubscriber\NetThirty\CheckoutPaymentDebugSubscriber">
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="NMIPayment\EventSubscriber\NetThirty\NetThirtyCustomerApprovalWriteSubscriber">
            <argument type="service" id="customer.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <!--        End Event Subscribers-->

        <!--        Validations-->
        <service id="NMIPayment\Validations\PaymentValidation">
            <argument id="Symfony\Component\Validator\Validator\ValidatorInterface" type="service"/>
        </service>

        <service id="NMIPayment\Validations\VaultOwnershipGuard">
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>
        <!--        End Validations-->


        <!-- services -->

        <service id="NMIPayment\Service\NetThirtyFields"/>

        <service id="NMIPayment\Service\NetThirtyCustomerEligibilityService">
            <argument type="service" id="NMIPayment\Service\DealerConfigService"/>
            <argument type="service" id="customer.repository"/>
        </service>

        <service id="NMIPayment\Service\NetThirtyOrderLifecycleService">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
        </service>

        <service id="NMIPayment\Service\NetThirtyEmailService">
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService" />
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="router"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NetThirtyPaymentOrchestrator">
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyEmailService"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyOrderLifecycleService"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NetThirtyPaymentLinkService">
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService"/>
            <argument type="service" id="router"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NetThirtyOrderAuthorizationService">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
        </service>

        <service id="NMIPayment\Service\NetThirtyBulkPaymentProcessor">
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentDataRequestService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NetThirtyACHBulkPaymentProcessor">
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService"/>
            <argument type="service" id="NMIPayment\Service\NMIACHPaymentDataRequestService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NetThirtyBulkPaymentService">
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyBulkPaymentProcessor"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyACHBulkPaymentProcessor"/>
        </service>

        <service id="NMIPayment\Service\DealerConfigService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="NMIPayment\Service\DealerDocumentCriteriaService">
            <argument type="service" id="NMIPayment\Service\DealerConfigService"/>
        </service>

        <!-- Net30 Controllers -->
        <service id="NMIPayment\Controller\AccountInvoicesController" public="true">
            <argument type="service" id="Shopware\Storefront\Page\Account\Order\AccountOrderPageLoader"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyBulkPaymentService"/>
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyOrderAuthorizationService"/>
            <argument type="service" id="NMIPayment\Service\NMIVaultedCustomerService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="NMIPayment\Controller\NetThirtyPaymentLinkController" public="true">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="NMIPayment.logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="NMIPayment\Controller\Admin\NetThirtyOrderController" public="true">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyPaymentLinkService"/>
            <argument type="service" id="NMIPayment\Service\NetThirtyEmailService"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Controller\Admin\NetThirtyCustomerApprovalController" public="true">
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="NMIPayment.logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- Net30 Scheduled Task -->
        <service id="NMIPayment\ScheduledTask\CheckExpiredNetThirtyPaymentsTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="NMIPayment\ScheduledTask\CheckExpiredNetThirtyPaymentsTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="NMIPayment.logger"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="NMIPayment\ScheduledTask\NmiCaptureSweepTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="NMIPayment\ScheduledTask\NmiCaptureSweepTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="NMIPayment.logger"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="NMIPayment\Service\NmiCaptureService"/>
            <argument type="service" id="NMIPayment.logger"/>
            <tag name="messenger.message_handler" handles="NMIPayment\ScheduledTask\NmiCaptureSweepTask"/>
        </service>

        <service id="NMIPayment\Command\CaptureNmiOrderCommand">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="NMIPayment\Service\NmiCaptureService"/>
            <tag name="console.command"/>
        </service>

        <!-- Net30 Command -->
        <service id="NMIPayment\Command\GenerateDealerInvoicesCommand">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Document\Service\DocumentGenerator"/>
            <argument type="service" id="NMIPayment\Service\DealerConfigService"/>
            <tag name="console.command"/>
        </service>

        <service id="NMIPayment\Service\NmiTransactionService">
            <argument type="service" id="nmi_transaction.repository"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository" />
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NmiCaptureService">
            <argument type="service" id="NMIPayment\Service\NmiTransactionService"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="partial_delivery.repository" on-invalid="null"/>
            <argument type="service" id="order_delivery.repository"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\VaultedCustomerService">
            <argument type="service" id="nmi_vaulted_customer.repository"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NMIConfigService">
            <argument id="Shopware\Core\System\SystemConfig\SystemConfigService" type="service"/>
        </service>

        <service id="NMIPayment\Service\CardVelocityService">
            <argument type="service" id="nmi_card_velocity.repository"/>
            <argument type="service" id="NMIPayment\Service\NMIConfigService"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NMIPaymentDataRequestService">
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
            <argument type="service" id="Shopware\Core\System\NumberRange\ValueGenerator\NumberRangeValueGeneratorInterface"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NMIVaultedCustomerService">
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="NMIPayment\Service\NMIPaymentDataRequestService"/>
            <argument type="service" id="NMIPayment\Service\VaultedCustomerService"/>
            <argument type="service" id="Shopware\Core\System\NumberRange\ValueGenerator\NumberRangeValueGeneratorInterface"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NMIACHPaymentDataRequestService">
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="NMIPayment\Service\NMIPaymentApiClient"/>
            <argument type="service" id="Shopware\Core\System\NumberRange\ValueGenerator\NumberRangeValueGeneratorInterface"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>

        <service id="NMIPayment\Service\NMIWebhookService">
            <argument type="service" id="NMIPayment\Service\NMIConfigService" />
            <argument type="service" id="NMIPayment\Service\NmiTransactionService"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="NMIPayment.logger"/>
        </service>
        <!-- services -->

        <!-- Logger -->

        <service id="NMIPayment.logger" class="Monolog\Logger">
            <argument type="string">Nmi</argument>
            <argument type="collection">
                <argument type="service" id="NMIPayment.rotatingHandler"/>
            </argument>
        </service>

        <service id="NMIPayment.rotatingHandler" class="Monolog\Handler\RotatingFileHandler">
            <argument type="string">%kernel.logs_dir%/NMIPayment-%kernel.environment%.log</argument>
            <argument>7</argument>
        </service>

    </services>
</container>
